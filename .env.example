# رهط بوست — أسماء المتغيرات فقط. لا تضع أسراراً حقيقية في هذا الملف ولا ترفعه بعد ملئه.
# انسخ القيم إلى Vercel → Project → Settings → Environment Variables → Production، ثم أعد النشر.
# هذا الملف مثال فارغ. الموقع الحي يقرأ القيم من Vercel، لا من هنا.

# --- قاعدة البيانات (Neon عبر Vercel) ---
# رابط Postgres. من لوحة Neon أو من Vercel → Storage → Neon → .env.
# DATABASE_URL_UNPOOLED يُستخدم أثناء البناء لتشغيل الجداول. إن وُجد الاثنان، اتركهما كما أنشأتهما Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- جلسات الدخول ---
# سر طويل عشوائي (32 حرفاً على الأقل) من مدير كلمات المرور. لا تعِد استخدامه لكلمة مرور الإدارة.
# بدونه يتوقف تسجيل الدخول على الموقع المنشور.
BETTER_AUTH_SECRET=
# عنوان الموقع العلني. اتركه هكذا لموقع rahatpost.com.
BETTER_AUTH_URL=https://rahatpost.com

# --- كلمة مرور لوحة التحكم ---
# 8 أحرف على الأقل. إن تُركت فارغة، زر «دخول المالك» يرفض الدخول ويشرح السبب.
# لا توجد كلمة مرور افتراضية.
ADMIN_PASSWORD=
# بريد المالك الموثّق (يمكن أكثر من بريد مفصول بفاصلة). هذا الحساب يدير الصلاحيات بعد تسجيل الدخول.
ADMIN_MASTER_EMAIL=owner@example.com

# --- Google (دخول الزوار) ---
# من Google Cloud → APIs & Services → Credentials → OAuth client (Web).
# Authorized JavaScript origins: https://rahatpost.com  و  https://www.rahatpost.com
# Authorized redirect URI (انسخه كما هو):
#   https://rahatpost.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook ---
# من developers.facebook.com → Facebook Login → Settings.
# Valid OAuth Redirect URI (انسخه كما هو):
#   https://rahatpost.com/api/auth/callback/facebook
# App Domains: rahatpost.com    Site URL: https://rahatpost.com
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Apple (مطلوب لمتجر آيفون إذا كان الدخول بجوجل ظاهراً) ---
# APPLE_CLIENT_ID هو Services ID (مثل com.rahatpost.web) وليس معرّف التطبيق com.rahatpost.app.
# Return URL (انسخه كما هو):
#   https://rahatpost.com/api/auth/callback/apple
# Domain: rahatpost.com
# APPLE_PRIVATE_KEY هو نص ملف AuthKey_XXXX.p8. في Vercel اكتب أسطره مع \n بين الأسطر.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- تخزين الصور (Vercel Blob) ---
# من Vercel → Storage → Blob → Create token (Read and write). بدونه لا تُرفع صور الإعلانات على الموقع المنشور.
BLOB_READ_WRITE_TOKEN=

# --- البريد (Resend) — إعادة تعيين كلمة المرور ورسائل الطلبات ---
# من resend.com → API Keys. STORE_EMAIL_FROM يجب أن يكون من نطاق موثّق في Resend، مثل "Rahat Post <news@rahatpost.com>".
RESEND_API_KEY=
STORE_EMAIL_FROM=

# --- إشعارات المتصفح (مفاتيح VAPID، ليست مفاتيح الدفع) ---
# زوج مفاتيح عام/خاص. بدونهما يظهر للزائر أن الإشعارات غير متاحة. الموقع يعمل بدونها.
# VAPID_SUBJECT بريد أو رابط للتواصل، مثل mailto:owner@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# --- روابط التطبيق (بعد نشر التطبيق في المتاجر) ---
# بصمة SHA-256 من Google Play → App signing، مفصولة بفاصلة إن كانت أكثر من واحدة.
ASSETLINKS_SHA256=
# معرّف فريق آبل المكوّن من 10 أحرف. نفس APPLE_TEAM_ID أعلاه يكفي إن كان هو نفسه.
# يُستخدم أيضاً لملف روابط آيفون على الموقع.

# --- الترجمة الآلية (اختياري؛ يمكن حفظ المفاتيح من لوحة التحكم بدل البيئة) ---
# TRANSLATE_PROVIDER=off يوقف الترجمة. وإلا يُستخدم Gemini أو xAI أو Azure إن وُجد مفتاح.
TRANSLATE_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=
XAI_API_KEY=
XAI_MODEL=
XAI_IMAGE_MODEL=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
MYMEMORY_EMAIL=

# --- إحصاءات جوجل (اختياري؛ يمكن ضبطها من لوحة التحكم) ---
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# --- تحقق محركات البحث (اختياري) ---
# الرمز فقط، بدون علامات HTML. من Google Search Console و Bing Webmaster.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- محلي فقط، لا تضفه على Vercel ---
# RP_DEV_LOGIN=1 يفتح دخول بريد تجريبي على جهاز المطوّر فقط، وليس على الموقع المنشور.
# RP_DEV_LOGIN=
