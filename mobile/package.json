{
  "name": "rahatpost-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "Store apps (Android/iOS) for رهط بوست — a Capacitor shell around https://rahatpost.com",
  "scripts": {
    "sync": "cap sync",
    "assets": "capacitor-assets generate --iconBackgroundColor '#FDB700' --splashBackgroundColor '#FDB700'",
    "android:debug": "cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "cap sync android && cd android && ./gradlew bundleRelease",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^7.0.0",
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.0"
  }
}
