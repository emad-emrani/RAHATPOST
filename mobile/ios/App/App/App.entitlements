<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: https://rahatpost.com/.well-known/apple-app-site-association (needs APPLE_TEAM_ID on Vercel).
	     Enable "Associated Domains" for the App ID com.rahatpost.app in the Apple Developer portal. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:rahatpost.com</string>
	</array>
</dict>
</plist>
